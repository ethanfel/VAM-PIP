#!/usr/bin/env python3
import os
from pathlib import Path
import sys


repository = Path(__file__).resolve().parent
local_state = repository / ".vampip"
os.environ.setdefault("VAMPIP_STATE_DIR", str(local_state))
addon_config = local_state / "addon-dir"
if "VAMPIP_ADDON_DIR" not in os.environ and addon_config.is_file():
    os.environ["VAMPIP_ADDON_DIR"] = addon_config.read_text(
        encoding="utf-8"
    ).strip()

sys.path.insert(0, str(repository / "src"))

from vampip.manager_cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
